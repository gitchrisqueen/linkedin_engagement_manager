[Unit]
# Pull the pipeline from main and prove it still runs. See scripts/agent-pipeline/sync.sh.
Description=LEM agent-pipeline self-update from main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lem
Group=lem
Environment=BASE=/home/lem/agent-pipeline
Environment=LEM_SYNC_SRC=/home/lem/agent-pipeline-src
WorkingDirectory=/home/lem/agent-pipeline-src

# sync.sh fetches and fast-forwards the mirror itself, refusing a dirty or diverged one, then
# re-execs the fetched copy. The unit used to force the mirror onto origin/main here, which
# discarded whatever was on the mirror (evidence included) and bypassed those refusals.
ExecStart=/home/lem/agent-pipeline-src/scripts/agent-pipeline/sync.sh

# A failed sync must not take the box with it: sync.sh already rolled itself back by the time it
# exits non-zero, so there is nothing for systemd to retry.
SuccessExitStatus=0 1
TimeoutStartSec=300
Slice=lem-agent.slice

[Install]
WantedBy=multi-user.target
